/// Short-lived, single-use Owner Gmail OAuth state + PKCE binding (A5.3, D069/D070).
/// Persists SHA-256 `stateHash` only (never the raw OAuth state) and an AES-256-GCM
/// encrypted PKCE verifier envelope. Rows are consumed atomically once and expire quickly;
/// they never contain OAuth tokens or authorization codes.
model GmailOAuthState {
  id                    String    @id @db.VarChar(64)
  /// SHA-256 hex digest of the raw OAuth `state`. Unique. Raw state is never stored.
  stateHash             String    @unique @map("state_hash") @db.VarChar(64)
  organizationId        String    @map("organization_id") @db.VarChar(64)
  ownerId               String    @map("owner_id") @db.VarChar(64)
  /// Purpose-bound AES-256-GCM envelope for the PKCE verifier. Nulled on consume.
  encryptedPkceVerifier String?   @map("encrypted_pkce_verifier") @db.Text
  encryptionKeyVersion  String    @map("encryption_key_version") @db.VarChar(64)
  redirectPath          String    @map("redirect_path") @db.VarChar(512)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt             DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt            DateTime? @map("consumed_at") @db.Timestamptz(3)

  @@index([organizationId])
  @@index([expiresAt])
  @@index([consumedAt])
  @@map("gmail_oauth_states")
}

/// Task Reminder Schedule — the durable scheduling *state* of one Task (A8.3a; D104, D109).
///
/// **Task-scoped, at most one per Task** (D104): the schedule survives reassignment, so it is not
/// bound to an Assignment. `taskId` is unique for that reason.
///
/// **This table stores facts; it never computes them.** Every occurrence column is written from a
/// value the caller computed with the A8.2 domain (`decideAdvanceReminder`,
/// `selectNextOverdueOccurrence`). No repository, trigger, default, or generated column in this
/// package derives "tomorrow", "overdue", or a 09:00 local instant — D103 places that arithmetic
/// exclusively in `packages/domain/src/reminders/`.
///
/// Local dates are stored as canonical `YYYY-MM-DD` **text**, not `DATE`, deliberately: Prisma
/// surfaces a `DATE` column as a `DateTime`, which would reintroduce the instant-vs-calendar-date
/// confusion D103 exists to remove. Migration SQL adds a format CHECK; full Gregorian validity
/// (leap years, month lengths) is enforced by the domain `parseLocalDate` at the boundary.
model TaskReminderSchedule {
  id             String @id @db.VarChar(64)
  organizationId String @map("organization_id") @db.VarChar(64)
  /// One schedule per Task (D104). Unique, not just indexed.
  taskId         String @unique @map("task_id") @db.VarChar(64)

  /// The organization-local calendar date this generation was established for (D103, D109).
  /// A generation snapshot, not a live mirror of `Task.dueLocalDate`: materiality is decided by
  /// comparing the two with the domain `isDueDateChangeMaterial`.
  dueLocalDate       String @map("due_local_date") @db.VarChar(10)
  /// IANA zone snapshot used to resolve this generation's occurrences (D103, D109). Persisted so a
  /// later constant change cannot silently reinterpret occurrences already scheduled and audited.
  schedulingTimeZone String @map("scheduling_time_zone") @db.VarChar(64)

  /// Monotonically increasing per Task; a material due-date change opens the next one (D104).
  generation             Int                         @default(1)
  status                 ReminderScheduleStatus      @default(active)
  stopReason             ReminderScheduleStopReason? @map("stop_reason")
  stoppedAt              DateTime?                   @map("stopped_at") @db.Timestamptz(3)
  /// When Waiting suspended this schedule (D107). Cleared on resume.
  suspendedAt            DateTime?                   @map("suspended_at") @db.Timestamptz(3)
  /// Raised when the overdue ceiling is reached or a permanent failure occurs (D106, D108).
  requiresOwnerAttention Boolean                     @default(false) @map("requires_owner_attention")

  /// Optimistic-concurrency version for the *reminder* resource (A8.3b audit F5).
  ///
  /// Separate from `Task.version` because a reminder mutation deliberately does not bump the Task,
  /// so a Task ETag cannot detect that reminder state moved. Incremented by every transition that
  /// changes what an Owner decision was based on — opening a generation, reactivating, suspending,
  /// resuming, stopping — and deliberately **not** by delivery counting or the attention flag, so a
  /// worker recording a send cannot invalidate an Owner's in-flight due-date edit. Exposed only
  /// through the reminder ETag; it is never a request field.
  reminderVersion Int @default(1) @map("reminder_version")

  /// Decided at establishment and never reclassified from the current clock (D105). The one later
  /// change permitted is a Waiting period that spanned the occurrence, which marks it
  /// `skipped_waiting_elapsed` on resume (A8 lifecycle audit H-2). The occurrence itself is always
  /// stored — even when skipped — so the Owner surface can say which morning was missed.
  advanceDisposition         ReminderAdvanceDisposition @map("advance_disposition")
  advanceOccurrenceLocalDate String                     @map("advance_occurrence_local_date") @db.VarChar(10)
  advanceOccurrenceAt        DateTime                   @map("advance_occurrence_at") @db.Timestamptz(3)

  /// The single next future overdue occurrence — never a backlog (D105, D106). Null when the
  /// schedule is stopped or suspended.
  nextOverdueOccurrenceLocalDate String?   @map("next_overdue_occurrence_local_date") @db.VarChar(10)
  nextOverdueOccurrenceAt        DateTime? @map("next_overdue_occurrence_at") @db.Timestamptz(3)

  /// Successful overdue deliveries **in this generation only** (D106). Bounded at 14 by a CHECK
  /// constraint in migration SQL; resets to zero when a new generation opens.
  overdueDeliveredCount Int @default(0) @map("overdue_delivered_count")

  /// Claim lease for a future A8.4 worker. Present now so the worker slice adds no migration, and
  /// so overlapping scheduler invocations can be made safe by CAS rather than by application luck.
  /// All three columns are null together or set together (CHECK in migration SQL).
  claimedBy      String?   @map("claimed_by") @db.VarChar(64)
  claimedAt      DateTime? @map("claimed_at") @db.Timestamptz(3)
  claimExpiresAt DateTime? @map("claim_expires_at") @db.Timestamptz(3)

  /// When the current generation was established — the instant the advance decision was made
  /// against (D105).
  establishedAt DateTime @map("established_at") @db.Timestamptz(3)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  task     Task                      @relation(fields: [taskId], references: [id], onDelete: Restrict)
  attempts ReminderDeliveryAttempt[]

  @@index([organizationId, status, nextOverdueOccurrenceAt])
  @@index([organizationId, status, advanceOccurrenceAt])
  @@index([organizationId, requiresOwnerAttention])
  @@index([claimExpiresAt])
  /// Global internal due-scan (A8.4a, A8.3a audit F11). Organization-leading indexes cannot serve a
  /// scan that deliberately spans organizations; the migration makes this one partial on `active`.
  @@index([nextOverdueOccurrenceAt, id])
  /// Global internal advance due-scan (A8.4b.3). The advance scan is a different question from the
  /// overdue one — one fixed occurrence per generation, gated on its disposition rather than on a
  /// rolling pointer — so it gets its own index rather than sharing the overdue one. The migration
  /// makes this partial on `active` *and* on `advance_disposition = 'scheduled'`, which is what keeps
  /// it small: every generation leaves exactly one advance row behind, and all but the undelivered
  /// ones drop out of the index the moment their disposition settles.
  @@index([advanceOccurrenceAt, id])
  @@map("task_reminder_schedules")
}

/// One processed reminder occurrence (A8.3a; D100, D106, D109).
///
/// **Append-only history.** Rows are superseded, never deleted or rewritten (D107, D109): a new
/// generation adds rows, it does not remove the previous generation's.
///
/// **Idempotency is server-derived and enforced by the database, not by application code** (D109).
/// There is deliberately no caller-supplied idempotency key: identity *is*
/// `(scheduleId, generation, occurrenceKind, occurrenceLocalDate)`, so a duplicate or overlapping
/// scheduler invocation collides on a unique index it cannot forge. A second partial unique index
/// in migration SQL additionally enforces D106's "at most one delivery per local calendar day" over
/// successful rows.
///
/// **No capability token, capability URL, message body, or recipient content is stored here**
/// (D109, D114). `failureCode` is a short normalized code only.
model ReminderDeliveryAttempt {
  id             String @id @db.VarChar(64)
  organizationId String @map("organization_id") @db.VarChar(64)
  scheduleId     String @map("schedule_id") @db.VarChar(64)
  /// Denormalized for Task-scoped history reads without a join (mirrors HandoffAttempt).
  taskId         String @map("task_id") @db.VarChar(64)

  /// Generation identity — part of the idempotency tuple (D104, D109).
  generation          Int
  occurrenceKind      ReminderOccurrenceKind @map("occurrence_kind")
  /// The organization-local calendar day this occurrence belongs to. Encoded in the idempotency
  /// identity exactly as D109 requires.
  occurrenceLocalDate String                 @map("occurrence_local_date") @db.VarChar(10)
  /// The resolved 09:00-local instant, computed by the A8.2 domain and stored for audit.
  occurrenceAt        DateTime               @map("occurrence_at") @db.Timestamptz(3)

  outcome     ReminderDeliveryOutcome
  skipReason  ReminderSkipReason?     @map("skip_reason")
  /// Short normalized failure code. Never a provider body, recipient address, or capability value.
  failureCode String?                 @map("failure_code") @db.VarChar(64)

  /// Retry bookkeeping for a future worker; a retry reuses the row rather than forging a new
  /// identity, which is what keeps the per-day guarantee intact.
  attemptCount Int       @default(1) @map("attempt_count")
  claimedAt    DateTime? @map("claimed_at") @db.Timestamptz(3)
  claimedBy    String?   @map("claimed_by") @db.VarChar(64)
  /// When the outcome became terminal.
  completedAt  DateTime? @map("completed_at") @db.Timestamptz(3)

  /// Occurrence lease expiry (A8.4a, A8.3a audit F2). Before this column a claim was indefinite, so
  /// a worker that died mid-occurrence froze it forever and nothing could tell an active claim from
  /// an abandoned one.
  claimExpiresAt DateTime? @map("claim_expires_at") @db.Timestamptz(3)
  /// Monotonically increasing per occurrence; incremented by every claim and reclaim. This is the
  /// fencing token: a claimant proves ownership by presenting the sequence it was granted, so a
  /// resurrected predecessor cannot finalize or release the occurrence its successor now owns.
  claimSequence  Int       @default(0) @map("claim_sequence")

  /// Set immediately before the transport is invoked and never cleared (A8.4a).
  ///
  /// This is the difference between the two recovery classes. An expired lease with this null means
  /// nothing left the building and the occurrence may be reclaimed; an expired lease with this set
  /// means a provider may already have accepted the message, so the occurrence is finalized
  /// `ambiguous` and never retried rather than risking a duplicate reminder to a real Recipient.
  providerCallStartedAt DateTime? @map("provider_call_started_at") @db.Timestamptz(3)
  /// When the provider accepted the message. Durable proof a send happened, written in the same
  /// statement that terminalizes the outcome and never rolled back for a schedule change (F1).
  providerAcceptedAt    DateTime? @map("provider_accepted_at") @db.Timestamptz(3)
  /// Short normalized provider reference. Never a body, address, subject, or capability value.
  providerMessageRef    String?   @map("provider_message_ref") @db.VarChar(128)

  /// When phase B — schedule settlement — completed for this terminal occurrence (A8.4a audit H1).
  ///
  /// Terminalizing the occurrence and settling the schedule are two transactions, because a
  /// settlement failure must never roll back the record of a message that already left the
  /// building. This column is the durable seam between them: a terminal row with it null is
  /// settlement debt, and the worker's first act is to discharge that debt before doing new work.
  ///
  /// Rows that were never worker-processed — the establishment and Waiting-resume skips — are born
  /// settled, because the transaction that wrote them settled the schedule in the same breath. A
  /// `claimed` row always has it null, which a CHECK enforces, so a retry takeover necessarily
  /// clears it and the row cannot claim to be settled while it is still owed.
  scheduleSettledAt DateTime? @map("schedule_settled_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  schedule TaskReminderSchedule @relation(fields: [scheduleId], references: [id], onDelete: Restrict)
  task     Task                 @relation(fields: [taskId], references: [id], onDelete: Restrict)

  @@unique([scheduleId, generation, occurrenceKind, occurrenceLocalDate])
  @@index([organizationId, taskId, occurrenceAt])
  @@index([scheduleId, generation, outcome])
  @@index([organizationId, outcome, occurrenceAt])
  /// Expired-claim recovery sweep (A8.4a). Partial in migration SQL: only `claimed` rows can expire.
  @@index([claimExpiresAt])
  /// Settlement-debt sweep (A8.4a audit H1). Partial in migration SQL on unsettled terminal rows,
  /// so it stays empty in steady state no matter how much terminal history accumulates.
  @@index([scheduleSettledAt, completedAt])
  /// Retry-budget-exhaustion sweep (A8.4a audit B2). Partial in migration SQL on non-terminal rows
  /// with no in-flight marker; the budget itself is a runtime policy number, so it is compared in
  /// the query rather than baked into the predicate.
  @@index([attemptCount])
  @@map("reminder_delivery_attempts")
}

/// One notifiable Owner event that has occurred and has not yet been delivered (A8.5a; D133–D135).
///
/// **Written in the triggering mutation's own transaction, never derived from the audit log.**
/// `AuditEvent` is the record of what happened; it cannot say what is still *owed*, because
/// `action` is a free-form string with no enum, the table carries no monotonic ordering column, and
/// several paths write it outside the mutation transaction. Overloading it would also put delivery
/// workflow state inside the record of truth. So intent is its own durable concept, inserted
/// alongside `createAuditEvent` in the same transaction: a mutation cannot commit without its
/// intent, and a rolled-back mutation cannot leave one behind.
///
/// **Identity is server-derived and enforced by the database** (D133, following D109). There is
/// deliberately no caller-supplied idempotency key: identity *is*
/// `(organizationId, eventType, subjectKind, subjectId, occurrenceKey)`. For Task lifecycle events
/// the `occurrenceKey` is the post-mutation `Task.version`, which the domain bumps on every
/// transition — so a retried mutation cannot forge a second row for the same transition, while a
/// legitimate repeat (a Recipient asking for clarification twice) lands on a different version and
/// is correctly a second row.
///
/// **No foreign key to `Task`, deliberately.** An event is a statement that something happened, and
/// it has to stay true and deliverable if its subject is later purged under retention. `subjectKind`
/// and `subjectId` are a descriptive reference, not a constraint.
///
/// **Not a reminder occurrence.** Reminder policy does not reach this table (D135): no generation,
/// no local calendar day, no per-day uniqueness, no delivery ceiling, no consecutive-ambiguity stop,
/// and no Waiting suspension. An Owner notification is one message about one event.
///
/// **No destination is stored** (D134). The address is resolved at delivery time from the
/// organization's connected `CommunicationAccount`, so a mailbox disconnected since the event cannot
/// be mailed from a stale copy. No message body, subject, capability token, or excerpt is stored
/// here either (D109, D114).
model OwnerNotificationIntent {
  id             String @id @db.VarChar(64)
  organizationId String @map("organization_id") @db.VarChar(64)

  /// Canonical event type. The database stores the ratified dotted name (D133); the Prisma member
  /// name is its identifier-safe spelling.
  eventType     OwnerNotificationEventType   @map("event_type")
  /// What the event is about. Descriptive only — see the no-foreign-key note above.
  subjectKind   OwnerNotificationSubjectKind @map("subject_kind")
  subjectId     String                       @map("subject_id") @db.VarChar(64)
  /// Completes the identity so a legitimate repeat is representable and a retry is not.
  occurrenceKey String                       @map("occurrence_key") @db.VarChar(128)

  /// Delivery state. Only `pending` is reachable in A8.5a — nothing claims or delivers yet. The rest
  /// of the machine is declared now, with its CHECK constraints, so A8.5b adds behaviour rather than
  /// a second migration; the reminder claim-lease columns were added ahead of their worker for the
  /// same reason.
  state             OwnerNotificationState              @default(pending)
  /// Set if and only if `state = 'suppressed'` (CHECK in migration SQL). D135's staleness horizon
  /// and the unavailable-channel case are the two reasons; neither is implemented in A8.5a.
  suppressionReason OwnerNotificationSuppressionReason? @map("suppression_reason")
  /// Short normalized code. Never a provider body, address, MIME fragment, or capability value.
  failureCode       String?                             @map("failure_code") @db.VarChar(64)

  /// Provider attempts spent so far. Bounded at three by D135 as runtime policy, not by a CHECK,
  /// because the number is a delivery decision rather than a storage invariant.
  attemptCount Int @default(0) @map("attempt_count")

  /// Claim lease for the A8.5b worker. All three are null together or set together, and non-null
  /// only while `state = 'claimed'` (CHECKs in migration SQL).
  claimedBy      String?   @map("claimed_by") @db.VarChar(64)
  claimedAt      DateTime? @map("claimed_at") @db.Timestamptz(3)
  claimExpiresAt DateTime? @map("claim_expires_at") @db.Timestamptz(3)
  /// Fencing token, incremented by every claim and reclaim, so a resurrected predecessor cannot
  /// finalize an intent its successor now owns. Mirrors `ReminderDeliveryAttempt.claimSequence`.
  claimSequence  Int       @default(0) @map("claim_sequence")

  /// When the event happened — the triggering mutation's own instant, not when it was noticed.
  /// This is what D135's 24-hour staleness horizon is measured against, and the order the worker
  /// takes work in.
  occurredAt DateTime  @map("occurred_at") @db.Timestamptz(3)
  /// When the intent became terminal. Null for `pending`, `claimed`, and `failed_retryable`; set for
  /// every terminal state (CHECK in migration SQL).
  settledAt  DateTime? @map("settled_at") @db.Timestamptz(3)

  /// Truthful attribution of the **triggering event**, copied from the audit row written in the same
  /// transaction so the two can never disagree. A Recipient action stays capability-attributed: the
  /// Owner is the audience, not the actor. Delivery itself is a separate `system` action recorded in
  /// `owner_notification_attempts` and in audit, not here.
  actorKind        AuditActorKind @map("actor_kind")
  ownerId          String?        @map("owner_id") @db.VarChar(64)
  capabilityId     String?        @map("capability_id") @db.VarChar(64)
  systemId         String?        @map("system_id") @db.VarChar(64)
  assignmentId     String?        @map("assignment_id") @db.VarChar(64)
  attributionLabel String?        @map("attribution_label") @db.VarChar(256)

  /// The audit row this intent was written beside. A plain reference with no foreign key, because
  /// audit retention must never be able to block or cascade into an undelivered notification.
  auditEventId String? @map("audit_event_id") @db.VarChar(64)

  /// D115 observability seam. Already minted per request by route context; carried so a notification
  /// can be traced back to the request that caused it without a new identifier scheme.
  requestId     String? @map("request_id") @db.VarChar(64)
  correlationId String? @map("correlation_id") @db.VarChar(64)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  attempts OwnerNotificationAttempt[]

  /// The deduplication identity (D133). Named explicitly because the generated name would be
  /// truncated mid-word at PostgreSQL's 63-character identifier limit, and a constraint whose name
  /// cannot be read is a constraint nobody diagnoses.
  @@unique([organizationId, eventType, subjectKind, subjectId, occurrenceKey], map: "owner_notification_intents_identity_key")
  /// Ordering support for the A8.5b claimable-work scan. The migration additionally creates
  /// `owner_notification_intents_pending_idx`, partial on `state = 'pending'`, which is the index
  /// that scan actually uses; Prisma cannot express a partial index, so it lives in SQL only — the
  /// same split the reminder due-scan indexes use.
  @@index([occurredAt, id], map: "owner_notification_intents_occurred_at_idx")
  /// "What has this Task produced" for the A8.6 Owner surface.
  @@index([organizationId, subjectKind, subjectId], map: "owner_notification_intents_subject_idx")
  @@map("owner_notification_intents")
}

/// One provider attempt against one Owner notification intent (A8.5a; D135).
///
/// **Append-only.** A retry adds a row rather than rewriting one, so the history can say how many
/// times a provider was contacted and what each contact returned. Nothing writes to this table in
/// A8.5a — it exists now so A8.5b and A8.5c add behaviour without a second migration.
///
/// **No message content.** `providerMessageRef` is a short normalized reference; there is no body,
/// subject, address, header, capability value, or provider response payload here (D109, D114, D134).
model OwnerNotificationAttempt {
  id             String @id @db.VarChar(64)
  organizationId String @map("organization_id") @db.VarChar(64)
  intentId       String @map("intent_id") @db.VarChar(64)

  /// 1-based, unique within the intent, so a duplicate attempt collides rather than double-counting.
  attemptNumber Int @map("attempt_number")

  outcome     OwnerNotificationAttemptOutcome
  /// Short normalized failure code. Never a provider body or raw OAuth/Gmail error payload.
  failureCode String?                         @map("failure_code") @db.VarChar(64)

  /// Committed immediately before the transport is invoked and never cleared. An attempt still
  /// `in_flight` when its lease expires may already have been accepted, which is what makes the
  /// outcome `ambiguous` rather than retryable.
  providerCallStartedAt DateTime? @map("provider_call_started_at") @db.Timestamptz(3)
  /// Durable proof the provider accepted. Required for `sent` and forbidden otherwise (CHECK in
  /// migration SQL), mirroring the reminder F1 invariant.
  providerAcceptedAt    DateTime? @map("provider_accepted_at") @db.Timestamptz(3)
  providerMessageRef    String?   @map("provider_message_ref") @db.VarChar(128)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  intent OwnerNotificationIntent @relation(fields: [intentId], references: [id], onDelete: Restrict)

  @@unique([intentId, attemptNumber], map: "owner_notification_attempts_intent_attempt_key")
  @@index([organizationId, intentId], map: "owner_notification_attempts_org_intent_idx")
  @@map("owner_notification_attempts")
}

/// Completed interpretation occurrence (D161). Provisional carrier name for the one persisted
/// interpretation-occurrence concept — grouping/provenance truth, not canonical Task truth.
///
/// **Completed successful outcomes only.** A failed provider call does not create a row. There is
/// no pending/running/claim/lease lifecycle here. `no_proposals` is truthful success (zero
/// TaskSuggestions), distinct from A6 `skipped_irrelevant` / `AI_EMPTY_OUTPUT`.
///
/// **Idempotency (HandoffAttempt pattern):** unique `(organizationId, idempotencyKey)`; same key +
/// same fingerprint is replay; same key + different fingerprint is `IDEMPOTENCY_KEY_CONFLICT`.
/// `idempotencyKey`, `requestFingerprint`, and durable-traceability `requestId` are required — not nullable.
///
/// **Ownership (D161).** One occurrence owns 0..N TaskSuggestions through the child's nullable
/// `interpretationRunId`. There is no unique constraint on that edge, and suggestions without an
/// occurrence remain valid.
///
/// **Producer (D169 S3.1).** The shared interpretation application service writes rows here through
/// `persistInterpretationOccurrence`, which commits one occurrence and its 0..N proposals in one
/// transaction. That service is backend-only: no route, Owner-review surface, worker, or cron
/// reaches it. Declaring a `sourceKind` still authorizes no further producer. No raw-input retention
/// and no CommunicationEvent linkage.
model InterpretationRun {
  id                 String                   @id @db.VarChar(64)
  organizationId     String                   @map("organization_id") @db.VarChar(64)
  idempotencyKey     String                   @map("idempotency_key") @db.VarChar(128)
  requestFingerprint String                   @map("request_fingerprint") @db.VarChar(128)
  /// Which kind of source this occurrence interpreted. Required: an occurrence with undeclared
  /// provenance is not meaningful.
  sourceKind         InterpretationSourceKind @map("source_kind")
  outcome            InterpretationRunOutcome
  modelVersion       String                   @map("model_version") @db.VarChar(64)
  policyVersion      String                   @map("policy_version") @db.VarChar(64)
  requestId          String                   @map("request_id") @db.VarChar(64)
  createdAt          DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)

  /// 0..N proposals produced by this occurrence. `no_proposals` occurrences legitimately have none.
  taskSuggestions TaskSuggestion[]

  @@unique([organizationId, idempotencyKey])
  @@map("interpretation_runs")
}

