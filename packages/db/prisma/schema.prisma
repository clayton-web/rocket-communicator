/// Lifecycle of a Task Reminder Schedule (A8.3a; D104, D106, D107).
/// `suspended_waiting` exists because Waiting is the *only* suspension mechanism (D107, D097):
/// there is deliberately no `paused` or `snoozed` value to represent a second pause control.
enum ReminderScheduleStatus {
  active
  suspended_waiting
  stopped
}

/// Why a schedule stopped (D106, D107). Recorded rather than inferred, so the Owner-visible
/// reason and the audit trail cannot disagree. A stopped schedule never restarts automatically.
/// `repeated_ambiguous_outcomes` is D129 (A8.4b.2): three consecutive terminal ambiguous overdue
/// occurrences in one generation. Distinct from `permanent_delivery_failure`, which records a
/// provider saying no; this one records a provider that never said anything definite three mornings
/// running, so nobody knows whether the Recipient was mailed. The two remedies differ, so the two
/// reasons must. Derived from occurrence history at settlement — no counter is stored anywhere.
enum ReminderScheduleStopReason {
  task_completed
  task_dismissed
  due_date_removed
  overdue_ceiling_reached
  permanent_delivery_failure
  repeated_ambiguous_outcomes
}

/// The advance-reminder decision for one generation, made at establishment and thereafter changed by
/// exactly one event (D105, D107). A scheduler run must never reclassify it from the current clock,
/// which is why it is stored rather than recomputed.
///
/// `skipped_window_elapsed` means the advance morning had already passed when the Owner chose the
/// date, so no advance reminder was ever scheduled. `skipped_waiting_elapsed` means the opposite
/// history: the advance reminder *was* validly scheduled, and the Task was Waiting when it came due,
/// so it is permanently skipped for this generation and never replayed on resume (A8 lifecycle audit
/// H-2). The two stay distinct so the history can say which happened.
/// What happened to this generation's advance occurrence.
///
/// `scheduled` is the only non-terminal value: everything else says the occurrence is settled and
/// must never be sent. A terminal outcome on the advance attempt row and this column are written in
/// the same transaction (A8.4a), so the schedule and the attempt history cannot disagree about the
/// same occurrence — the disagreement the A8 lifecycle re-audit found reachable once a worker exists.
enum ReminderAdvanceDisposition {
  scheduled
  skipped_window_elapsed
  skipped_waiting_elapsed
  delivered
  skipped_not_eligible
  failed_permanent
  ambiguous
}

/// Which occurrence a delivery attempt belongs to. Mirrors the A8.2 domain
/// `ReminderOccurrenceOutcome['occurrence']` union exactly so persisted rows feed
/// `countSuccessfulOverdueDeliveries` without translation.
enum ReminderOccurrenceKind {
  advance
  overdue
}

/// Outcome of one processed occurrence. Mirrors the A8.2 domain
/// `ReminderOccurrenceOutcome['outcome']` union exactly (D100 permits lifecycle outcomes without
/// locking names). `claimed` is a *lease*, not a delivery: D106 requires that claims, failures,
/// ambiguity, and skips never count toward the overdue ceiling.
enum ReminderDeliveryOutcome {
  claimed
  success
  retryable_failure
  permanent_failure
  ambiguous
  skipped
}

/// Truthful skip reasons (D105, D107). `advance_window_elapsed` is product law: an advance
/// occurrence already in the past at establishment is recorded as skipped, never sent late.
enum ReminderSkipReason {
  advance_window_elapsed
  no_active_assignment
  task_not_eligible
  schedule_superseded
  /// D130: assigned, eligible, armed — and the original assignment email's capability is revoked,
  /// expired, or never activated. The reminder has no working link to point at (A8.4b.1).
  no_actionable_capability
}

/// The ten canonical Owner-notifiable event types, closed by D133. The database stores the ratified
/// dotted names; Prisma members carry the identifier-safe spelling and `@map` the real value.
///
/// The list is exhaustive on purpose. There is no `task.updated`, and an audit row is not a reason
/// to send mail: every Owner-initiated action is excluded, because telling the Owner what the Owner
/// just did is noise, and operational detail belongs to the D118 attention surface. Only
/// `task.completed_by_recipient` has a producer in A8.5a; the rest are added in A8.5d, and the
/// enum is complete now so that slice adds producers rather than enum values.
enum OwnerNotificationEventType {
  task_completed_by_recipient                  @map("task.completed_by_recipient")
  task_clarification_requested                 @map("task.clarification_requested")
  task_returned_to_owner                       @map("task.returned_to_owner")
  handoff_delivery_failed                      @map("handoff.delivery_failed")
  gmail_disconnected                           @map("gmail.disconnected")
  capability_expired                           @map("capability.expired")
  reminder_schedule_stopped_ceiling_reached    @map("reminder.schedule.stopped.ceiling_reached")
  reminder_schedule_stopped_permanent_failure  @map("reminder.schedule.stopped.permanent_failure")
  reminder_schedule_stopped_repeated_ambiguous @map("reminder.schedule.stopped.repeated_ambiguous")
  reminder_no_active_assignment                @map("reminder.no_active_assignment")
}

/// What an intent is about. Descriptive only — `OwnerNotificationIntent` holds no foreign key to its
/// subject, so an event survives the deletion or retention purge of the thing it describes (D133).
enum OwnerNotificationSubjectKind {
  task
  task_capability
  task_reminder_schedule
  handoff_attempt
  communication_account
}

/// Delivery state of one Owner notification (D135). Only `pending` is reachable in A8.5a.
///
/// Terminal states are `sent`, `failed_permanent`, `ambiguous`, `suppressed`, and
/// `requires_owner_attention`; each requires `settled_at`, and the non-terminal states forbid it
/// (CHECKs in migration SQL).
///
/// `ambiguous` is terminal on first occurrence rather than retryable, and that is the deliberate
/// difference from D129: the provider may already have accepted the message, and a duplicate Owner
/// email about an event is a worse untruth than a late one. `requires_owner_attention` is where a
/// notification lands when its three-attempt budget is spent — it is a durable state rather than a
/// derived view, so the A8.6 surface reads a fact instead of recomputing a policy.
enum OwnerNotificationState {
  pending
  claimed
  sent
  failed_retryable
  failed_permanent
  ambiguous
  suppressed
  requires_owner_attention
}

/// Why a notification was terminalized without being delivered. Set if and only if the state is
/// `suppressed` (CHECK in migration SQL). Neither reason is implemented in A8.5a.
enum OwnerNotificationSuppressionReason {
  /// D135's 24-hour horizon: older than the horizon at processing time, so terminalized with a
  /// truthful reason and no provider call. This is what stops a backlog flushing when delivery is
  /// first enabled.
  stale
  /// No connected Gmail account satisfied D134 at delivery time, so there was nowhere truthful to
  /// send. Distinct from a transport failure: nothing was attempted.
  channel_unavailable
}

/// Outcome of one provider attempt (D135). Distinct from `OwnerNotificationState` because an attempt
/// can be `in_flight` and can never be `pending` or `suppressed`.
enum OwnerNotificationAttemptOutcome {
  /// Committed before the transport call. A row left here by a crash is what an expired lease finds,
  /// and it resolves to `ambiguous` rather than to a retry.
  in_flight
  sent
  failed_retryable
  failed_permanent
  ambiguous
}

/// Successful completed interpretation outcomes only (D161). `no_proposals` is truthful success —
/// not failure, not A6 `skipped_irrelevant`, and not a reason to invent a fake TaskSuggestion.
enum InterpretationRunOutcome {
  proposals_created
  no_proposals
}

/// Provenance discriminator for the source an interpretation occurrence interpreted (D161).
/// Extend with `ALTER TYPE ... ADD VALUE` when a further source (SMS, post-call capture) gains an
/// authorized interpretation path. Representation is not authorization.
enum InterpretationSourceKind {
  owner_manual_capture
  gmail
}

/// Who authored a recorded TaskSuggestion revision-evidence row (D155).
/// Distinguishes AI-generated proposal evidence from Owner-authored correction evidence.
/// Multi-Owner identity attribution (`authoredByOwnerId`) is deferred until product requires it.
enum TaskSuggestionRevisionAuthorKind {
  ai
  owner
}

/// Which party the Owner affirmatively selected as initially responsible at acceptance (D168).
/// `owner` means the Owner chose Me and requires no TaskAssignment and no Recipient (D164);
/// `recipient` names an external Recipient and still requires the existing assignment/capability/
/// handoff machinery for any delivery. Neither value may be inferred from operational absence.
enum ResponsibilitySelectionPartyKind {
  owner
  recipient
}
