generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/client"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Recipient contact record for an Owner organization. Not an application account (D049).
/// Active-email uniqueness within an organization is enforced by a partial unique index in
/// migration SQL on `email_normalized` WHERE `active` (Prisma cannot express partial uniques).
/// Inactive rows retain historical identity and may share a normalized email with a later active row.
model Recipient {
  id                   String   @id @db.VarChar(64)
  organizationId       String   @map("organization_id") @db.VarChar(64)
  displayName          String   @map("display_name") @db.VarChar(256)
  email                String   @db.VarChar(320)
  /// Lowercased trimmed email for uniqueness/lookup (D087).
  emailNormalized      String   @map("email_normalized") @db.VarChar(320)
  relationshipLabel    String?  @map("relationship_label") @db.VarChar(64)
  active               Boolean  @default(true)
  reminderPreferences  Json?    @map("reminder_preferences")
  assignmentCategories Json?    @map("assignment_categories")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  assignments     TaskAssignment[]
  capabilities    TaskCapability[]
  handoffAttempts HandoffAttempt[]
  /// Acceptance-time responsibility-selection evidence naming this Recipient (D168). Evidence of
  /// Owner selection only — never assignment, capability, handoff, or delivery.
  responsibilitySelections TaskSuggestionResponsibilitySelection[]

  @@index([organizationId])
  @@index([organizationId, emailNormalized])
  @@map("recipients")
}

model Task {
  id                    String        @id @db.VarChar(64)
  organizationId        String        @map("organization_id") @db.VarChar(64)
  status                TaskStatus
  priorActionableStatus TaskStatus?   @map("prior_actionable_status")
  summaryPoints         Json          @map("summary_points")
  sourceReference       Json?         @map("source_reference")
  dueAt                 DateTime?     @map("due_at") @db.Timestamptz(3)
  /// Authoritative organization-local due **calendar date**, canonical `YYYY-MM-DD` (D103, D109).
  /// `dueAt` is retained for contract compatibility and is *not* the scheduling authority.
  /// Deliberately **not backfilled** from `dueAt`: D109 forbids historical due dates activating
  /// reminders, so existing Tasks keep this null until an Owner explicitly saves a due date.
  dueLocalDate          String?       @map("due_local_date") @db.VarChar(10)
  waitingUntil          DateTime?     @map("waiting_until") @db.Timestamptz(3)
  priority              TaskPriority?
  outcome               Json?
  reminder              Json
  retention             Json
  version               Int           @default(1)
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  assignments            TaskAssignment[]
  notes                  TaskNote[]
  capabilities           TaskCapability[]
  handoffAttempts        HandoffAttempt[]
  reminderSchedule       TaskReminderSchedule?
  reminderAttempts       ReminderDeliveryAttempt[]
  suggestionsMerged      TaskSuggestion[]          @relation("MergedIntoTask")
  /// Suggestion that created this Task via Owner approve (D080/D082). At most one.
  approvedFromSuggestion TaskSuggestion?           @relation("ApprovedTask")
  /// Acceptance-time responsibility-selection evidence (D168). Historical evidence of the Owner's
  /// initial choice — NOT this Task's current responsibility, assignee, or custody, which D164 and
  /// D168 forbid representing on Task at all. Read current external assignment from TaskAssignment.
  acceptanceResponsibilitySelection TaskSuggestionResponsibilitySelection?

  @@index([organizationId, status])
  @@index([organizationId, updatedAt])
  @@map("tasks")
}

/// Assignment history for a task. Multiple rows per task over time are allowed.
/// At most one active assignment (`clearedAt` IS NULL) is enforced by a partial unique
/// index in migration SQL (not expressible accurately in Prisma schema metadata).
model TaskAssignment {
  id                       String                    @id @db.VarChar(64)
  organizationId           String                    @map("organization_id") @db.VarChar(64)
  taskId                   String                    @map("task_id") @db.VarChar(64)
  recipientId              String                    @map("recipient_id") @db.VarChar(64)
  intendedRecipientEmail   String                    @map("intended_recipient_email") @db.VarChar(320)
  assignedAt               DateTime                  @map("assigned_at") @db.Timestamptz(3)
  assignedByOwnerId        String                    @map("assigned_by_owner_id") @db.VarChar(64)
  assignmentApprovedAt     DateTime?                 @map("assignment_approved_at") @db.Timestamptz(3)
  allowedCapabilityActions Json                      @map("allowed_capability_actions")
  capabilityStatus         CapabilityStatus?         @map("capability_status")
  deliveryStatus           AssignmentDeliveryStatus? @map("delivery_status")
  activeCapabilityId       String?                   @map("active_capability_id") @db.VarChar(64)
  /// Null while assignment is current; set when returned/cleared. Cleared rows are immutable history.
  clearedAt                DateTime?                 @map("cleared_at") @db.Timestamptz(3)
  createdAt                DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)

  task            Task             @relation(fields: [taskId], references: [id], onDelete: Restrict)
  recipient       Recipient        @relation(fields: [recipientId], references: [id], onDelete: Restrict)
  capabilities    TaskCapability[]
  handoffAttempts HandoffAttempt[]

  @@index([taskId])
  @@index([organizationId])
  @@index([recipientId])
  @@map("task_assignments")
}

model TaskNote {
  id             String   @id @db.VarChar(64)
  organizationId String   @map("organization_id") @db.VarChar(64)
  taskId         String   @map("task_id") @db.VarChar(64)
  body           String   @db.VarChar(2000)
  /// ActionAttribution JSON (owner | capability). Must not claim verified Recipient identity.
  attribution    Json
  createdAt      DateTime @map("created_at") @db.Timestamptz(3)

  task Task @relation(fields: [taskId], references: [id], onDelete: Restrict)

  @@index([organizationId, taskId])
  @@index([taskId, createdAt])
  @@map("task_notes")
}

model TaskSuggestion {
  id                         String               @id @db.VarChar(64)
  organizationId             String               @map("organization_id") @db.VarChar(64)
  status                     TaskSuggestionStatus
  summaryPoints              Json                 @map("summary_points")
  sourceReference            Json?                @map("source_reference")
  proposedRecipientId        String?              @map("proposed_recipient_id") @db.VarChar(64)
  proposedDueAt              DateTime?            @map("proposed_due_at") @db.Timestamptz(3)
  proposedPriority           TaskPriority?        @map("proposed_priority")
  voiceOriginated            Boolean              @default(false) @map("voice_originated")
  /// Optional originating task for Recipient work requests (D061).
  originTaskId               String?              @map("origin_task_id") @db.VarChar(64)
  /// Authoritative Gmail-origin link (D081). Null for work-request suggestions.
  /// Unique when set as preserved A6 0..1 compatibility/legacy behaviour (D163), not
  /// current product cardinality (D161: one interpretation occurrence → 0..N).
  sourceCommunicationEventId String?              @unique @map("source_communication_event_id") @db.VarChar(64)
  /// Owning interpretation occurrence (D161). Deliberately NOT unique: one occurrence owns 0..N
  /// sibling proposals. Permanently nullable — A6 Gmail and Recipient work-request suggestions have
  /// no interpretation occurrence and stay valid without one.
  interpretationRunId        String?              @map("interpretation_run_id") @db.VarChar(64)
  /// Task created by Owner approve of this suggestion (D080/D082). Unique when set.
  approvedTaskId             String?              @unique @map("approved_task_id") @db.VarChar(64)
  mergedIntoTaskId           String?              @map("merged_into_task_id") @db.VarChar(64)
  retention                  Json
  version                    Int                  @default(1)
  createdAt                  DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                  DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  mergedIntoTask           Task?               @relation("MergedIntoTask", fields: [mergedIntoTaskId], references: [id], onDelete: SetNull)
  approvedTask             Task?               @relation("ApprovedTask", fields: [approvedTaskId], references: [id], onDelete: Restrict)
  sourceCommunicationEvent CommunicationEvent? @relation(fields: [sourceCommunicationEventId], references: [id], onDelete: Restrict)
  interpretationRun        InterpretationRun?  @relation(fields: [interpretationRunId], references: [id], onDelete: Restrict)
  /// Dormant append-only evidence only (D155). Absence of rows does not mean absence of a proposal.
  revisions                TaskSuggestionRevision[]
  /// Acceptance-time Owner responsibility-selection evidence (D168). Absence is not evidence that
  /// the Owner selected Me, and presence is not delivery.
  responsibilitySelection  TaskSuggestionResponsibilitySelection?

  @@index([organizationId, status])
  @@index([organizationId, originTaskId])
  @@index([organizationId, interpretationRunId])
  @@map("task_suggestions")
}

/// Append-only TaskSuggestion proposal-revision evidence (D155).
///
/// **Inert foundation.** No application producer writes rows yet. TaskSuggestion remains the mutable
/// operational/current proposal head. Revision rows are dormant evidence only — they must not
/// personalize, mutate prompts, auto-assign, train online, or otherwise influence AI behaviour.
///
/// **Revision numbering.** `revisionNumber` starts at 0 for the first revision Rocket actually
/// records for a suggestion. Revision 0 is not inherently AI: a future AI-created suggestion may
/// record revision 0 as `authorKind = ai`; a legacy suggestion whose first recorded evidence is an
/// Owner correction may legitimately begin with revision 0 as `authorKind = owner`. Absence of
/// revisions does not mean absence of a proposal. Existing suggestions receive no fabricated history.
///
/// **Not immutability protection.** Unique `(suggestionId, revisionNumber)` prevents duplicate
/// numbering; rewrite/delete prevention is by create/read-only repository surface + source guard.
/// Do not claim the unique constraint makes rows immutable.
///
/// **Out of this foundation:** `authoredByOwnerId`, `updatedAt`, status/accepted flags,
/// `acceptedRevisionId` on TaskSuggestion, interpretation-run linkage, peopleHints /
/// deadlineExpression / proposedRecipientHint, prompt/model/policy metadata, provider payload,
/// confidence/reasoning, auditEventId, sourceReference, voiceOriginated, changed-fields/diff
/// metadata, retention metadata, and learning/personalization metadata.
model TaskSuggestionRevision {
  id                   String                           @id @db.VarChar(64)
  organizationId       String                           @map("organization_id") @db.VarChar(64)
  suggestionId         String                           @map("suggestion_id") @db.VarChar(64)
  revisionNumber       Int                              @map("revision_number")
  authorKind           TaskSuggestionRevisionAuthorKind @map("author_kind")
  summaryPoints        Json                             @map("summary_points")
  proposedDueAt        DateTime?                        @map("proposed_due_at") @db.Timestamptz(3)
  proposedPriority     TaskPriority?                    @map("proposed_priority")
  proposedRecipientId  String?                          @map("proposed_recipient_id") @db.VarChar(64)
  createdAt            DateTime                         @default(now()) @map("created_at") @db.Timestamptz(3)

  suggestion TaskSuggestion @relation(fields: [suggestionId], references: [id], onDelete: Restrict)

  @@unique([suggestionId, revisionNumber])
  @@index([organizationId, suggestionId, revisionNumber], map: "task_suggestion_revisions_org_suggestion_revision_idx")
  @@map("task_suggestion_revisions")
}

/// Append-only Owner responsibility-selection evidence recorded at proposal acceptance (D168).
///
/// Stands beside TaskSuggestionRevision as an independent D155 evidence axis: responsibility
/// selection and accepted content revision are unrelated. Written atomically inside the existing
/// approve transaction, never as a later best-effort write.
///
/// **It answers exactly one question:** who did the Owner affirmatively choose as the initially
/// responsible party when accepting this proposal? It is **not** canonical Task state, current
/// custody, current responsibility, delivery/handoff state, a TaskAssignment replacement, a
/// current-responsibility projection, or a responsibility-history state machine. Later
/// reassignment, clearing, and return-to-Owner remain TaskAssignment/handoff/audit concerns.
///
/// **Affirmative only.** `partyKind` is NOT NULL and explicit. Absence of a row, absence of
/// `recipientId`, absence of TaskAssignment, and absence or failure of handoff must never be read
/// as evidence that the Owner selected Me (D155, D164).
///
/// **Recipient selection is not delivery.** A `recipient` row records the Owner's affirmative
/// selection only. It creates no TaskAssignment, TaskCapability, or HandoffAttempt, sends no mail,
/// and activates no Recipient access; a later failed, pending, cancelled, cleared, or absent
/// handoff never erases or falsifies it.
///
/// **Initial decision, not a stream.** Unique `suggestionId` and unique `taskId` hold this to at
/// most one initial acceptance record, which is what stops it accumulating into responsibility
/// history. Rewrite/delete prevention is by create/read-only repository surface + source guard.
///
/// **Out of this carrier:** `updatedAt`, status/lifecycle columns, superseding/current flags,
/// delivery or handoff state, capability linkage, `auditEventId`, accepted-revision linkage,
/// reassignment/return-to-Owner rows, and any learning/personalization metadata.
model TaskSuggestionResponsibilitySelection {
  id                String                           @id @db.VarChar(64)
  organizationId    String                           @map("organization_id") @db.VarChar(64)
  /// Accepted proposal this selection was made on. Unique: one initial selection per acceptance.
  suggestionId      String                           @unique @map("suggestion_id") @db.VarChar(64)
  /// Canonical Task the acceptance created. Unique for the same reason as `suggestionId`.
  taskId            String                           @unique @map("task_id") @db.VarChar(64)
  partyKind         ResponsibilitySelectionPartyKind @map("party_kind")
  /// Set when and only when `partyKind = recipient`; enforced by a migration CHECK constraint.
  recipientId       String?                          @map("recipient_id") @db.VarChar(64)
  /// Authenticated Owner whose approval action made the selection (`audit_events.owner_id` /
  /// `task_assignments.assigned_by_owner_id` convention). AuditEvent is not this evidence store.
  selectedByOwnerId String                           @map("selected_by_owner_id") @db.VarChar(64)
  /// Selection instant as of the Owner approval action, distinct from the row insert stamp.
  selectedAt        DateTime                         @map("selected_at") @db.Timestamptz(3)
  createdAt         DateTime                         @default(now()) @map("created_at") @db.Timestamptz(3)

  suggestion TaskSuggestion @relation(fields: [suggestionId], references: [id], onDelete: Restrict)
  task       Task           @relation(fields: [taskId], references: [id], onDelete: Restrict)
  recipient  Recipient?     @relation(fields: [recipientId], references: [id], onDelete: Restrict)

  @@index([organizationId, suggestionId], map: "task_suggestion_responsibility_selections_org_suggestion_idx")
  @@map("task_suggestion_responsibility_selections")
}

/// Capability authorization record. Stores token HASH only — never raw secrets (D063).
/// At most one `status = active` capability per assignment is enforced by a partial unique
/// index in migration SQL (Prisma cannot express it). Actionability for A7 handoff uses
/// `actionableAt` (null until Gmail send acceptance); legacy A4 rows backfilled to issuedAt.
model TaskCapability {
  id                     String                      @id @db.VarChar(64)
  organizationId         String                      @map("organization_id") @db.VarChar(64)
  taskId                 String                      @map("task_id") @db.VarChar(64)
  assignmentId           String                      @map("assignment_id") @db.VarChar(64)
  recipientId            String?                     @map("recipient_id") @db.VarChar(64)
  intendedRecipientEmail String                      @map("intended_recipient_email") @db.VarChar(320)
  scope                  Json
  status                 CapabilityStatus
  /// SHA-256 (or stronger) hex/base64url fingerprint of the raw secret. Unique.
  tokenHash              String                      @unique @map("token_hash") @db.VarChar(128)
  issuedAt               DateTime                    @map("issued_at") @db.Timestamptz(3)
  /// Explicit persisted expiry (D055).
  expiresAt              DateTime                    @map("expires_at") @db.Timestamptz(3)
  /// Null until the capability becomes Recipient-actionable (A7: after send acceptance).
  actionableAt           DateTime?                   @map("actionable_at") @db.Timestamptz(3)
  revokedAt              DateTime?                   @map("revoked_at") @db.Timestamptz(3)
  /// Internal D086 reason. Only `superseded` maps publicly to CAPABILITY_NO_LONGER_ACTIVE.
  revocationReason       CapabilityRevocationReason? @map("revocation_reason")
  /// Optional activity stamp; does not imply CapabilityStatus.used (D056).
  lastUsedAt             DateTime?                   @map("last_used_at") @db.Timestamptz(3)
  createdAt              DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(3)

  task            Task             @relation(fields: [taskId], references: [id], onDelete: Restrict)
  assignment      TaskAssignment   @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  recipient       Recipient?       @relation(fields: [recipientId], references: [id], onDelete: SetNull)
  handoffAttempts HandoffAttempt[]

  @@index([organizationId, taskId])
  @@index([organizationId, status, expiresAt])
  @@index([assignmentId])
  @@map("task_capabilities")
}

/// Durable A7 handoff/delivery attempt (D092). Authoritative delivery status lives here;
/// TaskAssignment.deliveryStatus is denormalized and kept in sync by handoff transactions.
/// Provider message id uniqueness is org-scoped via migration partial unique
/// `handoff_attempts_org_provider_message_id_key` WHERE provider_message_id IS NOT NULL
/// (Prisma cannot express partial uniques).
model HandoffAttempt {
  id                 String                  @id @db.VarChar(64)
  organizationId     String                  @map("organization_id") @db.VarChar(64)
  taskId             String                  @map("task_id") @db.VarChar(64)
  recipientId        String                  @map("recipient_id") @db.VarChar(64)
  assignmentId       String                  @map("assignment_id") @db.VarChar(64)
  capabilityId       String                  @map("capability_id") @db.VarChar(64)
  /// Stable D037 acknowledgement version token (e.g. handoff_confirmed_v1).
  acknowledgement    String                  @db.VarChar(64)
  deliveryPath       HandoffDeliveryPath     @map("delivery_path")
  status             HandoffAttemptStatus
  intent             HandoffIntent
  idempotencyKey     String                  @map("idempotency_key") @db.VarChar(128)
  /// Digest of canonical security-relevant fingerprint (org, task, recipient, acknowledgement).
  requestFingerprint String                  @map("request_fingerprint") @db.VarChar(128)
  /// Gmail provider message id after send acceptance; null until sent. Immutable once set.
  providerMessageId  String?                 @map("provider_message_id") @db.VarChar(128)
  providerAcceptedAt DateTime?               @map("provider_accepted_at") @db.Timestamptz(3)
  failureCode        String?                 @map("failure_code") @db.VarChar(64)
  failureCategory    HandoffFailureCategory? @map("failure_category")
  /// Privacy-safe opaque fingerprint — never raw provider text or message content.
  failureFingerprint String?                 @map("failure_fingerprint") @db.VarChar(128)
  retryable          Boolean?
  attemptCount       Int                     @default(1) @map("attempt_count")
  priorAttemptId     String?                 @map("prior_attempt_id") @db.VarChar(64)
  rootAttemptId      String?                 @map("root_attempt_id") @db.VarChar(64)
  createdAt          DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)

  task       Task           @relation(fields: [taskId], references: [id], onDelete: Restrict)
  recipient  Recipient      @relation(fields: [recipientId], references: [id], onDelete: Restrict)
  assignment TaskAssignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  capability TaskCapability @relation(fields: [capabilityId], references: [id], onDelete: Restrict)

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, taskId, status])
  @@index([organizationId, status, updatedAt])
  @@index([assignmentId])
  @@index([capabilityId])
  @@index([providerMessageId])
  @@map("handoff_attempts")
}

/// A4 audit events (D057). Extended in A5 with system actor (D074) and optional Gmail refs.
model AuditEvent {
  id                     String         @id @db.VarChar(64)
  organizationId         String         @map("organization_id") @db.VarChar(64)
  actorKind              AuditActorKind @map("actor_kind")
  ownerId                String?        @map("owner_id") @db.VarChar(64)
  capabilityId           String?        @map("capability_id") @db.VarChar(64)
  /// System actor identifier when actorKind = system (D074). Never a Gmail token.
  systemId               String?        @map("system_id") @db.VarChar(64)
  assignmentId           String?        @map("assignment_id") @db.VarChar(64)
  taskId                 String?        @map("task_id") @db.VarChar(64)
  suggestionId           String?        @map("suggestion_id") @db.VarChar(64)
  communicationAccountId String?        @map("communication_account_id") @db.VarChar(64)
  communicationEventId   String?        @map("communication_event_id") @db.VarChar(64)
  gmailSyncRunId         String?        @map("gmail_sync_run_id") @db.VarChar(64)
  intendedRecipientEmail String?        @map("intended_recipient_email") @db.VarChar(320)
  action                 String         @db.VarChar(64)
  outcome                AuditOutcome
  resourceVersion        Int?           @map("resource_version")
  taskStatus             String?        @map("task_status") @db.VarChar(32)
  note                   String?        @db.VarChar(2000)
  requestId              String?        @map("request_id") @db.VarChar(64)
  correlationId          String?        @map("correlation_id") @db.VarChar(64)
  /// Human-readable label; must not claim verified Recipient identity (D051/D052).
  attributionLabel       String?        @map("attribution_label") @db.VarChar(256)
  recordedAt             DateTime       @map("recorded_at") @db.Timestamptz(3)

  @@index([organizationId, recordedAt])
  @@index([organizationId, taskId])
  @@index([organizationId, capabilityId])
  @@index([organizationId, communicationAccountId])
  @@index([requestId])
  @@map("audit_events")
}

/// One Gmail mailbox connection per organization (A5). Tokens live in GmailOAuthCredential only.
model CommunicationAccount {
  id                String                     @id @db.VarChar(64)
  organizationId    String                     @map("organization_id") @db.VarChar(64)
  provider          CommunicationProvider
  emailAddress      String                     @map("email_address") @db.VarChar(320)
  externalAccountId String                     @map("external_account_id") @db.VarChar(256)
  status            CommunicationAccountStatus
  historyId         String?                    @map("history_id") @db.VarChar(128)
  historyState      GmailHistoryState          @map("history_state")
  connectedAt       DateTime?                  @map("connected_at") @db.Timestamptz(3)
  disconnectedAt    DateTime?                  @map("disconnected_at") @db.Timestamptz(3)
  lastSyncAt        DateTime?                  @map("last_sync_at") @db.Timestamptz(3)
  lastSuccessAt     DateTime?                  @map("last_success_at") @db.Timestamptz(3)
  lastErrorCode     String?                    @map("last_error_code") @db.VarChar(64)
  lastErrorAt       DateTime?                  @map("last_error_at") @db.Timestamptz(3)
  syncLockUntil     DateTime?                  @map("sync_lock_until") @db.Timestamptz(3)
  /// Opaque lock owner (sync run / request id). Only the owner may release a non-expired lock.
  syncLockOwner     String?                    @map("sync_lock_owner") @db.VarChar(64)
  createdAt         DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)

  credential GmailOAuthCredential?
  events     CommunicationEvent[]
  syncRuns   GmailSyncRun[]

  @@unique([organizationId, provider])
  @@index([organizationId, status])
  @@index([syncLockUntil])
  @@map("communication_accounts")
}

/// Encrypted Gmail OAuth material (D070). Ciphertext only — no encryption implementation in A5.1–A5.2.
model GmailOAuthCredential {
  id                    String    @id @db.VarChar(64)
  accountId             String    @unique @map("account_id") @db.VarChar(64)
  organizationId        String    @map("organization_id") @db.VarChar(64)
  encryptedRefreshToken String    @map("encrypted_refresh_token") @db.Text
  encryptedAccessToken  String?   @map("encrypted_access_token") @db.Text
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(3)
  grantedScopes         String    @map("granted_scopes") @db.VarChar(512)
  tokenType             String?   @map("token_type") @db.VarChar(32)
  encryptionKeyVersion  String    @map("encryption_key_version") @db.VarChar(64)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  account CommunicationAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("gmail_oauth_credentials")
}

/// Minimized Gmail communication event (D067–D072, D077). No MIME/HTML archives or attachment bytes.
model CommunicationEvent {
  id                           String                     @id @db.VarChar(64)
  organizationId               String                     @map("organization_id") @db.VarChar(64)
  accountId                    String                     @map("account_id") @db.VarChar(64)
  sourceType                   String                     @map("source_type") @db.VarChar(32)
  providerMessageId            String                     @map("provider_message_id") @db.VarChar(256)
  providerThreadId             String                     @map("provider_thread_id") @db.VarChar(256)
  dedupeKey                    String                     @map("dedupe_key") @db.VarChar(128)
  internalDate                 DateTime                   @map("internal_date") @db.Timestamptz(3)
  receivedAt                   DateTime                   @map("received_at") @db.Timestamptz(3)
  fromAddress                  String                     @map("from_address") @db.VarChar(320)
  toAddresses                  Json                       @map("to_addresses")
  subject                      String?                    @db.VarChar(256)
  snippet                      String?                    @db.VarChar(512)
  labelIds                     Json                       @map("label_ids")
  hasAttachments               Boolean                    @default(false) @map("has_attachments")
  attachmentMetadata           Json                       @map("attachment_metadata")
  status                       CommunicationEventStatus
  ingestRunId                  String?                    @map("ingest_run_id") @db.VarChar(64)
  purgeAt                      DateTime?                  @map("purge_at") @db.Timestamptz(3)
  /// D081 suggestion-processing state (A6). A5 ingest leaves events as unprocessed.
  suggestionProcessingStatus   SuggestionProcessingStatus @default(unprocessed) @map("suggestion_processing_status")
  suggestionProcessedAt        DateTime?                  @map("suggestion_processed_at") @db.Timestamptz(3)
  suggestionProcessingAttempts Int                        @default(0) @map("suggestion_processing_attempts")
  suggestionLastErrorCode      String?                    @map("suggestion_last_error_code") @db.VarChar(64)
  suggestionClaimUntil         DateTime?                  @map("suggestion_claim_until") @db.Timestamptz(3)
  suggestionClaimOwner         String?                    @map("suggestion_claim_owner") @db.VarChar(64)
  suggestionPolicyVersion      String?                    @map("suggestion_policy_version") @db.VarChar(64)
  createdAt                    DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                    DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)

  account     CommunicationAccount           @relation(fields: [accountId], references: [id], onDelete: Restrict)
  excerpt     TemporaryCommunicationExcerpt?
  suggestions TaskSuggestion[]

  @@unique([organizationId, providerMessageId])
  @@unique([organizationId, dedupeKey])
  @@index([organizationId, internalDate])
  @@index([accountId, internalDate])
  @@index([organizationId, purgeAt])
  @@index([suggestionProcessingStatus, suggestionClaimUntil])
  @@index([organizationId, suggestionProcessingStatus])
  @@map("communication_events")
}

