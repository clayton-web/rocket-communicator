# Local Docker PostgreSQL for Prisma CLI (never commit a real copy as secrets).
# Copy to packages/db/.env.docker if you want a file-based local URL.
#
# Prefer the repo scripts instead — they hardcode this URL and refuse non-loopback hosts:
#   pnpm db:docker:up
#   pnpm db:migrate:local
#   pnpm db:migrate:status:local
#   pnpm db:studio:local
#
# Do NOT put a Supabase / production pooler URL here.
# packages/db/.env is read by any Prisma command run from packages/db, so it must stay
# pointed at loopback. The unguarded `migrate:deploy` / `migrate:status` scripts that used
# to inherit it have been removed — use the `:local` scripts for Docker work.

DATABASE_URL="postgresql://prisma:prisma@127.0.0.1:5433/prisma?schema=public"

# Optional isolated test database (created by docker/postgres/init on first boot):
# DATABASE_URL="postgresql://prisma:prisma@127.0.0.1:5433/prisma_test?schema=public"
