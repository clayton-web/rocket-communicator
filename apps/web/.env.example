# Supabase (create a project at https://supabase.com)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Application URL for OAuth redirects (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Owner Google Workspace domain allowlist (authentication boundary only)
OWNER_WORKSPACE_DOMAIN=your-org.com

# Stable application organization identifier (not derived from email domain)
OWNER_ORGANIZATION_ID=org_your_organization_id

# Capability token runtime (server-only; never NEXT_PUBLIC)
# HMAC pepper for deterministic token lookup hashes (min 32 characters; do not commit real secrets)
CAPABILITY_TOKEN_PEPPER=replace-with-a-long-random-pepper-value
# TTL in milliseconds (D055 default seven days = 604800000)
CAPABILITY_TTL_MS=604800000

# Gmail OAuth (A5.3; server-only; never NEXT_PUBLIC). Names only — do not commit real values.
# Distinct from Supabase Owner authentication. Scope is gmail.readonly only.
GOOGLE_GMAIL_CLIENT_ID=
GOOGLE_GMAIL_CLIENT_SECRET=
# Optional; defaults to ${NEXT_PUBLIC_APP_URL}/api/v1/gmail/oauth/callback when unset.
# GMAIL_OAUTH_REDIRECT_URL=
# AES-256-GCM key material: 32 raw bytes encoded as 64 hex chars OR standard/base64url base64.
GMAIL_TOKEN_ENCRYPTION_KEY=
# Explicit key version stored with each ciphertext envelope (e.g. "1").
GMAIL_TOKEN_ENCRYPTION_KEY_VERSION=

# Internal Gmail poll / Vercel Cron (A5.5; server-only; never NEXT_PUBLIC).
# Random secret, recommend ≥32 bytes. Vercel sends Authorization: Bearer <CRON_SECRET>.
# Configure in Production only; do not give Preview the production secret.
# Same CRON_SECRET authenticates POST /api/v1/internal/suggestions/process (A6.3).
# CRON_SECRET=

# Suggestion AI extraction (A6.3; server-only; never NEXT_PUBLIC). Names only — do not commit values.
# OPENAI_API_KEY=
# Optional OpenAI-compatible base URL (defaults to https://api.openai.com/v1).
# OPENAI_BASE_URL=
# OPENAI_MODEL=gpt-4o-mini
# Set to "false" to disable extraction (process endpoint fails closed until configured).
# SUGGESTION_AI_ENABLED=
# SUGGESTION_AI_POLICY_VERSION=a6-suggestion-v1

# Owner Event Notification capture (A8.5a; D135; server-only; never NEXT_PUBLIC).
# Exact string "true" enables recording notification intent inside Task mutations. "1", "TRUE",
# "yes", and whitespace variants all leave it disabled — the default, and the state it must stay in
# everywhere until Gate 6 separately authorizes capture enablement (the A8.5 migration is already applied).
# Capture records intent only; it delivers nothing. ENABLE_OWNER_EVENT_DELIVERY is separate.
# ENABLE_OWNER_EVENT_CAPTURE=

# Owner Event Notification delivery (A8.5b; D135; server-only; never NEXT_PUBLIC).
# Exact string "true" lets POST /api/v1/internal/notifications/process claim and settle intents.
# Unset — the default and required state everywhere — the worker performs no delivery work at all:
# no scan, no claim, no attempt row, no transport. Since A8.5e the endpoint also has a capture phase
# under ENABLE_OWNER_EVENT_CAPTURE, so it is both flags being absent, not this one alone, that means
# the invocation opens no database connection.
# Since A8.5c a real Gmail adapter and Owner email renderer exist, so this flag is the only thing
# holding delivery shut: enabling it where intents exist (the A8.5a migration is already applied) would send
# mail from the organization's connected Gmail account to itself. Treat it as live ammunition.
# ENABLE_OWNER_EVENT_DELIVERY=

# Reminder occurrence delivery (A8.4a/A8.4b; D108; server-only; never NEXT_PUBLIC).
# Exact string "true" lets POST /api/v1/internal/reminders/process claim occurrences and is the sole
# condition under which a real Gmail reminder transport is constructed at all. Unset — the default and
# required state everywhere including Production — the route builds no transport, decrypts no refresh
# token, attempts no token exchange, and returns a zero-work response with deliveryEnabled: false.
# A reminder goes to a Recipient, not to the Owner. D108 gates enablement on the Event Notification
# Engine and the minimum Owner schedule-status UI both being operational; see docs/DEPLOYMENT.md.
# ENABLE_REMINDER_DELIVERY=

# Server-side Postgres for Prisma (@aicaa/db). Never expose this to the browser. Ordinary @aicaa/db
# Vitest suites use PGlite and do not need this. Production runtime uses the Supabase Shared Pooler
# transaction URI (port 6543); Prisma Migrate uses session mode (5432) — see docs/DEPLOYMENT.md.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public
